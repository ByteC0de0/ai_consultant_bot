# Скопируй этот файл в .env и впиши свои значения. Файл .env в git не попадает.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Название компании — в приветствии и в инструкции для ИИ
COMPANY_NAME=Кофейня «Зёрна»

# ========== ИИ: любой OpenAI-совместимый API ==========
# Провайдер переключается ТОЛЬКО этими тремя строками, код менять не нужно.
#
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=openai/gpt-4o-mini
#   ProxyAPI:    LLM_BASE_URL=https://api.proxyapi.ru/openai/v1 LLM_MODEL=gpt-4o-mini
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen2.5:14b
#                (локально и бесплатно; ключ — любая непустая строка, например ollama)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Необязательные настройки (ниже значения по умолчанию) ---

# «Креативность» ответов 0–2. Для консультанта лучше низкая: меньше выдумок
LLM_TEMPERATURE=0.2
# Сколько секунд ждать ответа ИИ и максимальная длина ответа в токенах
LLM_TIMEOUT=60
LLM_MAX_TOKENS=700

# Папка с базой знаний (.md и .txt). Файлы можно менять на ходу — бот перечитает их сам
KNOWLEDGE_DIR=knowledge
# Сколько самых подходящих фрагментов базы подставлять в запрос.
# 0 — отправлять всю базу целиком (подходит, пока база маленькая)
KNOWLEDGE_TOP_K=5
# Максимальный размер фрагмента в символах
CHUNK_SIZE=1200
# Файлы, которые подставляются в каждый запрос (через запятую) — например, контакты менеджера,
# чтобы бот всегда мог на него сослаться
KNOWLEDGE_ALWAYS=contacts.md

# Сколько последних сообщений диалога бот помнит (вопросы и ответы вместе)
HISTORY_SIZE=6
# Максимальная длина вопроса в символах
MAX_QUESTION_LENGTH=1000

# Примеры вопросов — кнопки в приветствии /start (через «|», до 8 штук, до 64 символов)
EXAMPLE_QUESTIONS=Сколько стоит капучино на овсяном молоке?|До скольки вы работаете в субботу?|Сколько стоит доставка?|Можно прийти с собакой?
